<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.LoginController"
      styleClass="login-root">
    <VBox styleClass="login-brand">
        <Region VBox.vgrow="ALWAYS"/>
        <ImageView fx:id="appIconView" fitWidth="120" fitHeight="120" preserveRatio="true" smooth="true"/>
        <Label fx:id="appNameLabel" styleClass="login-app-name"/>
        <Label fx:id="versionLabel" styleClass="login-version"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Label fx:id="developerLabel" styleClass="login-developer"/>
    </VBox>
    <VBox styleClass="login-form" HBox.hgrow="ALWAYS">
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="%login.heading" styleClass="login-heading"/>
        <Label text="%login.subtitle" styleClass="muted-text"/>
        <VBox styleClass="login-fields">
            <Label text="%user.field.username" styleClass="login-field-label"/>
            <HBox fx:id="usernameBox" styleClass="icon-field">
                <TextField fx:id="usernameField" styleClass="bare-field" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="%user.field.password" styleClass="login-field-label"/>
            <HBox fx:id="passwordBox" styleClass="icon-field">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField" styleClass="bare-field"/>
                    <TextField fx:id="visiblePasswordField" styleClass="bare-field" visible="false" editable="false"/>
                </StackPane>
                <Button fx:id="showPasswordButton" styleClass="eye-button" focusTraversable="false"/>
            </HBox>
            <Label fx:id="errorLabel" styleClass="field-error-text" wrapText="true" visible="false" managed="false"/>
        </VBox>
        <Button fx:id="loginButton" text="%login.action.login" onAction="#onLogin" defaultButton="true"
                styleClass="login-button" maxWidth="Infinity"/>
        <Hyperlink text="%login.exit" onAction="#onExit" styleClass="login-exit"/>
        <Region VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>
