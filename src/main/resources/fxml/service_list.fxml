<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.electrician.tracker.ui.controller.ServiceListController"
            styleClass="screen-root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <VBox spacing="10">
            <HBox spacing="10" styleClass="toolbar">
                <Label text="%home.section.services" styleClass="section-title"/>
                <ProgressIndicator fx:id="loadingIndicator" visible="false" maxHeight="20" maxWidth="20"/>
                <HBox spacing="0" styleClass="segmented">
                    <ToggleButton text="%home.filter.all" selected="true" userData="ALL">
                        <toggleGroup>
                            <ToggleGroup fx:id="filterGroup"/>
                        </toggleGroup>
                    </ToggleButton>
                    <ToggleButton text="%home.filter.paid" toggleGroup="$filterGroup" userData="PAID"/>
                    <ToggleButton text="%home.filter.unpaid" toggleGroup="$filterGroup" userData="UNPAID"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="%home.action.newService" onAction="#onNewService" styleClass="primary-button,action-add"/>
            </HBox>
            <HBox spacing="8" styleClass="toolbar">
                <Button text="%action.edit" onAction="#onEdit" styleClass="action-edit"/>
                <Button fx:id="paymentButton" text="%jobDetail.action.addPayment" onAction="#onPayment" styleClass="action-payment"/>
                <Button text="%jobDetail.action.addAttendance" onAction="#onAttendance" styleClass="action-attendance"/>
                <Button text="%home.action.exportPdf" onAction="#onPdf" styleClass="action-pdf"/>
                <Button fx:id="deleteButton" text="%action.delete" onAction="#onDelete" styleClass="danger-button,action-delete"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="serviceTable">
            <placeholder>
                <Label text="%home.service.empty"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="dateColumn" text="%service.field.date" prefWidth="100"/>
                <TableColumn fx:id="customerColumn" text="%job.field.customer" prefWidth="200"/>
                <TableColumn fx:id="descriptionColumn" text="%services.column.work" prefWidth="280"/>
                <TableColumn fx:id="amountColumn" text="%service.column.total" prefWidth="130"/>
                <TableColumn fx:id="paidColumn" text="%services.column.paymentStatus" prefWidth="130"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="4">
            <padding>
                <Insets top="8"/>
            </padding>
            <Label fx:id="pendingTotalLabel" styleClass="attendance-total"/>
            <Label text="%home.service.hint" styleClass="muted-text"/>
        </VBox>
    </bottom>
</BorderPane>
