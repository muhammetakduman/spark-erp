<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import com.electrician.tracker.ui.util.DecimalField?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.QuoteItemDialogController"
      styleClass="form-root" spacing="14" prefWidth="760">
    <padding>
        <Insets top="16" right="20" bottom="20" left="20"/>
    </padding>
    <HBox spacing="16" alignment="CENTER_LEFT">
        <RadioButton fx:id="catalogRadio" text="%quote.item.mode.catalog" selected="true">
            <toggleGroup>
                <ToggleGroup fx:id="modeGroup"/>
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="freeRadio" text="%quote.item.mode.free" toggleGroup="$modeGroup"/>
    </HBox>
    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="%material.field.product" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <VBox fx:id="productHolder"/>
            <VBox fx:id="freeItemRow" styleClass="limited-field" visible="false" managed="false">
                <TextField fx:id="freeNameField" promptText="%quote.item.freeName.prompt"/>
                <Label fx:id="freeNameCounter"/>
            </VBox>
        </VBox>

        <Label text="%product.field.brand" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <VBox styleClass="limited-field" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <TextField fx:id="brandField" promptText="%quote.item.brand.prompt"/>
            <Label fx:id="brandCounter"/>
        </VBox>

        <Label text="%material.field.quantity" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <DecimalField fx:id="quantityField" scale="3" padDecimals="false" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="unitComboBox" prefWidth="120"/>
        </HBox>

        <Label text="%quote.column.unitPrice" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="1">
            <DecimalField fx:id="unitPriceField" promptText="%quote.item.unitPrice.prompt"/>
            <Label fx:id="suggestionLabel" styleClass="muted-text" visible="false" managed="false"/>
        </VBox>

        <Label text="%quote.item.description" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <VBox styleClass="limited-field" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <TextField fx:id="descriptionField" promptText="%material.field.optional"/>
            <Label fx:id="descriptionCounter"/>
        </VBox>

        <Label text="%quote.column.total" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="lineTotalLabel" styleClass="attendance-total" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10" styleClass="dialog-buttons">
        <Button fx:id="saveButton" text="%action.save" onAction="#onSave" defaultButton="true"
                styleClass="primary-button,action-save"/>
        <Button text="%action.cancel" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>
