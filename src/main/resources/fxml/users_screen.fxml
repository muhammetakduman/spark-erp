<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.electrician.tracker.ui.controller.UserSettingsController"
            styleClass="screen-root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <VBox spacing="10">
            <HBox spacing="10" styleClass="toolbar">
                <Label text="%settings.section.users" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="%user.action.new" onAction="#onNewUser" styleClass="primary-button,action-add"/>
            </HBox>
            <HBox spacing="8" styleClass="toolbar">
                <Button text="%action.edit" onAction="#onEditUser" styleClass="action-edit"/>
                <Button text="%user.action.resetPassword" onAction="#onResetPassword" styleClass="action-password"/>
                <Button text="%user.action.toggleActive" onAction="#onToggleActive"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="userTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="usernameColumn" text="%user.field.username" prefWidth="140"/>
                <TableColumn fx:id="fullNameColumn" text="%user.field.fullName" prefWidth="200"/>
                <TableColumn fx:id="titleColumn" text="%user.field.title" prefWidth="160"/>
                <TableColumn fx:id="roleColumn" text="%user.field.role" prefWidth="120"/>
                <TableColumn fx:id="activeColumn" text="%employee.field.active" prefWidth="80"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label text="%user.role.hint" styleClass="muted-text" wrapText="true">
            <padding>
                <Insets top="8"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
