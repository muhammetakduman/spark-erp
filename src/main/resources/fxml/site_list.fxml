<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.electrician.tracker.ui.controller.SiteListController"
            fitToWidth="true" styleClass="screen-root">
    <VBox fx:id="rootContent" spacing="12">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        <HBox spacing="10" styleClass="toolbar">
            <Label text="%home.section.sites" styleClass="section-title"/>
            <ProgressIndicator fx:id="loadingIndicator" visible="false" maxHeight="20" maxWidth="20"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%home.action.newSite" onAction="#onNewSite" styleClass="primary-button,action-add"/>
        </HBox>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <TextField fx:id="siteSearchField" promptText="%home.search.prompt" prefColumnCount="22"/>
            <CheckBox fx:id="activeOnlyCheckBox" text="%home.filter.activeOnly" selected="true"/>
        </FlowPane>
        <StackPane fx:id="emptyHolder" styleClass="empty-holder" visible="false" managed="false"/>
        <Accordion fx:id="siteAccordion"/>
    </VBox>
</ScrollPane>
