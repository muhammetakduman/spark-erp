<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.TemplateFormController"
      styleClass="form-root" spacing="12" prefWidth="560">
    <padding>
        <Insets top="16" right="20" bottom="20" left="20"/>
    </padding>
    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%template.column.name" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%template.column.type" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeComboBox" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>
    <VBox fx:id="contentBox" spacing="4" VBox.vgrow="ALWAYS">
        <Label text="%template.column.content" styleClass="form-label"/>
        <TextArea fx:id="contentArea" prefRowCount="8" wrapText="true" VBox.vgrow="ALWAYS"/>
        <Label fx:id="contentCounter"/>
    </VBox>
    <HBox spacing="10" styleClass="dialog-buttons">
        <Button fx:id="saveButton" text="%action.save" onAction="#onSave" defaultButton="true"
                styleClass="primary-button,action-save"/>
        <Button text="%action.cancel" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>
