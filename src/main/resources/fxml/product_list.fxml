<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.electrician.tracker.ui.controller.ProductListController"
            styleClass="screen-root">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <top>
        <VBox spacing="8">
            <HBox spacing="10" styleClass="toolbar">
                <Label text="%menu.products" styleClass="section-title"/>
                <ProgressIndicator fx:id="loadingIndicator" visible="false" maxHeight="20" maxWidth="20"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="%product.action.new" onAction="#onNew" styleClass="primary-button,action-add"/>
                <Button text="%action.edit" onAction="#onEdit" styleClass="action-edit"/>
                <Button text="%action.delete" onAction="#onDelete" styleClass="danger-button,action-delete"/>
            </HBox>
            <HBox spacing="8" styleClass="toolbar">
                <TextField fx:id="searchField" promptText="%product.search.prompt" prefWidth="260"/>
                <ComboBox fx:id="categoryFilter" promptText="%product.field.category" prefWidth="160"/>
                <ComboBox fx:id="brandFilter" promptText="%product.field.brand" prefWidth="160"/>
                <ComboBox fx:id="supplierFilter" promptText="%material.field.supplier" prefWidth="180"/>
                <Button text="%product.filter.clear" onAction="#onClearFilters"/>
            </HBox>
            <Label fx:id="resultLabel" styleClass="muted-text"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.16">
            <VBox spacing="6">
                <Label text="%product.categories.title" styleClass="subsection-title"/>
                <ListView fx:id="categoryList" VBox.vgrow="ALWAYS"/>
            </VBox>
            <SplitPane orientation="VERTICAL" dividerPositions="0.45">
                <VBox spacing="6">
                    <Label fx:id="categoryTotalsLabel" styleClass="category-totals" visible="false" managed="false"/>
                    <TableView fx:id="productTable" VBox.vgrow="ALWAYS"/>
                </VBox>
                <fx:include fx:id="usagePanel" source="product_usage_panel.fxml"/>
            </SplitPane>
        </SplitPane>
    </center>
</BorderPane>
