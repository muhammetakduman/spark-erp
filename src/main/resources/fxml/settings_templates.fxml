<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.TemplateSettingsController"
      spacing="10" styleClass="settings-section">
    <HBox spacing="10" styleClass="toolbar">
        <Label text="%settings.section.templates" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%template.action.new" onAction="#onNew" styleClass="action-add"/>
    </HBox>
    <Label text="%settings.templates.hint" styleClass="muted-text" wrapText="true"/>
    <HBox spacing="16">
        <StackPane fx:id="diagramHolder" alignment="TOP_LEFT"/>
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="templateTable" prefHeight="190">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="nameColumn" text="%template.column.name" prefWidth="200"/>
                    <TableColumn fx:id="typeColumn" text="%template.column.type" prefWidth="170"/>
                    <TableColumn fx:id="defaultColumn" text="%template.column.default" prefWidth="90"/>
                    <TableColumn fx:id="usageColumn" text="%template.column.usage" prefWidth="160"/>
                </columns>
            </TableView>

            <Label fx:id="noSelectionLabel" text="%template.editor.noSelection" styleClass="muted-text"/>

            <VBox fx:id="editorBox" spacing="8" visible="false" managed="false">
                <VBox spacing="2">
                    <Label fx:id="editorTitleLabel" styleClass="subsection-title"/>
                    <Label fx:id="editorMetaLabel" styleClass="template-meta"/>
                    <Label fx:id="editorTypeLabel" styleClass="template-type-caption" wrapText="true"/>
                </VBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%template.column.name" styleClass="form-label"/>
                    <TextField fx:id="nameField" HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="defaultCheckBox" text="%template.editor.default"/>
                </HBox>

                <VBox fx:id="textEditorBox" spacing="6">
                    <TextArea fx:id="contentArea" prefRowCount="6" wrapText="true"/>
                    <Label fx:id="contentCounter"/>
                    <VBox fx:id="previewBox" spacing="4">
                        <Label text="%template.editor.preview" styleClass="form-label"/>
                        <VBox styleClass="pdf-notes-preview">
                            <Label fx:id="previewText" styleClass="pdf-notes-preview-text" wrapText="true"/>
                        </VBox>
                    </VBox>
                </VBox>

                <VBox fx:id="itemEditorBox" spacing="6">
                    <TableView fx:id="itemTable" prefHeight="200">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="itemProductColumn" text="%quote.column.product" prefWidth="260"
                                         sortable="false"/>
                            <TableColumn fx:id="itemQuantityColumn" text="%quote.column.quantity" prefWidth="90"
                                         sortable="false"/>
                            <TableColumn fx:id="itemUnitPriceColumn" text="%quote.column.unitPrice" prefWidth="120"
                                         sortable="false"/>
                            <TableColumn fx:id="itemTotalColumn" text="%quote.column.total" prefWidth="120"
                                         sortable="false"/>
                        </columns>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="table-actions">
                        <Button text="%quote.action.addItem" onAction="#onAddItem" styleClass="action-add"/>
                        <Button text="%quote.action.removeItem" onAction="#onRemoveItem"
                                styleClass="danger-button,action-delete"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="itemTotalLabel" styleClass="vat-summary-total"/>
                    </HBox>
                </VBox>

                <HBox spacing="8" styleClass="dialog-buttons">
                    <Button text="%action.delete" onAction="#onDelete" styleClass="danger-button,action-delete"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="%action.save" onAction="#onSave" styleClass="primary-button,action-save"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
