<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.TemplateSettingsController"
      spacing="10" styleClass="settings-section">
    <HBox spacing="10" styleClass="toolbar">
        <Label text="%settings.section.templates" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%template.action.new" onAction="#onNew" styleClass="action-add"/>
    </HBox>
    <Label text="%settings.templates.hint" styleClass="muted-text" wrapText="true"/>
    <TableView fx:id="templateTable" prefHeight="220">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameColumn" text="%template.column.name" prefWidth="200"/>
            <TableColumn fx:id="typeColumn" text="%template.column.type" prefWidth="160"/>
            <TableColumn fx:id="defaultColumn" text="%template.column.default" prefWidth="90"/>
            <TableColumn fx:id="contentColumn" text="%template.column.content" prefWidth="320"/>
        </columns>
    </TableView>
    <HBox spacing="8" styleClass="table-actions">
        <Button text="%action.edit" onAction="#onEdit" styleClass="action-edit"/>
        <Button fx:id="defaultButton" text="%template.action.toggleDefault" onAction="#onToggleDefault"/>
        <Button text="%action.delete" onAction="#onDelete" styleClass="danger-button,action-delete"/>
    </HBox>
</VBox>
