<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.electrician.tracker.ui.controller.HomeController"
            fitToWidth="true" styleClass="screen-root">
    <VBox fx:id="rootContent" spacing="24">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <HBox spacing="10" styleClass="toolbar">
            <Label text="%home.title" styleClass="section-title"/>
            <ProgressIndicator fx:id="loadingIndicator" visible="false" maxHeight="20" maxWidth="20"/>
        </HBox>

        <FlowPane fx:id="summaryCardsBox" hgap="14" vgap="14"/>

        <VBox fx:id="completedBalanceBox" spacing="4" styleClass="warning-panel" visible="false" managed="false">
            <Label text="%home.completedBalance.title" styleClass="warning-panel-title"/>
            <VBox fx:id="completedBalanceList" spacing="2"/>
        </VBox>

        <VBox spacing="8" styleClass="section">
            <Label text="%home.recent.title" styleClass="subsection-title"/>
            <VBox fx:id="recentList" spacing="4" styleClass="recent-list"/>
        </VBox>
    </VBox>
</ScrollPane>
