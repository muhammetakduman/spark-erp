<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.CompanySettingsController"
      fx:id="companySection" spacing="10" styleClass="settings-section">
    <Label text="%settings.section.company" styleClass="section-title"/>
    <Label text="%settings.company.hint" styleClass="muted-text" wrapText="true"/>
    <FlowPane hgap="24" vgap="16">
        <GridPane hgap="12" vgap="8" styleClass="form-grid" prefWidth="480">
            <columnConstraints>
                <ColumnConstraints minWidth="110"/>
                <ColumnConstraints minWidth="220" hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="%company.field.name" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="%company.field.slogan" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="sloganField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="%company.field.address" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="addressField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="%company.field.phone" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="%company.field.email" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="%company.field.web" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="webField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="%company.field.taxOffice" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="taxOfficeField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            <Label text="%company.field.taxNo" styleClass="form-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <TextField fx:id="taxNoField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            <Label text="%company.field.brandColor" styleClass="form-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
            <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="8" GridPane.columnIndex="1">
                <ColorPicker fx:id="brandColorPicker"/>
                <Label text="%company.brandColor.hint" styleClass="muted-text" wrapText="true"/>
            </HBox>
        </GridPane>
        <VBox spacing="8" styleClass="logo-column">
            <Label text="%company.field.logo" styleClass="form-label"/>
            <StackPane fx:id="logoDropZone" styleClass="logo-drop-zone">
                <VBox fx:id="logoPlaceholder" styleClass="logo-placeholder">
                    <Label fx:id="placeholderIconLabel"/>
                    <Label text="%company.logo.dropHint" styleClass="muted-text" wrapText="true"/>
                </VBox>
                <ImageView fx:id="logoView" fitWidth="220" fitHeight="100" preserveRatio="true" smooth="true"/>
                <ProgressIndicator fx:id="logoProgress" visible="false" maxWidth="28" maxHeight="28"/>
                <Button fx:id="removeLogoButton" onAction="#onRemoveLogo" styleClass="logo-remove-button"
                        StackPane.alignment="TOP_RIGHT" visible="false"/>
            </StackPane>
            <Label text="%company.logo.help" styleClass="muted-text" wrapText="true" maxWidth="260"/>
            <Label text="%company.logo.previewTitle" styleClass="form-label"/>
            <HBox fx:id="pdfPreview" styleClass="pdf-preview">
                <ImageView fx:id="previewLogoView" fitWidth="64" fitHeight="40" preserveRatio="true" smooth="true"/>
                <VBox spacing="2">
                    <Label fx:id="previewNameLabel" styleClass="pdf-preview-name"/>
                    <Label fx:id="previewAddressLabel" styleClass="pdf-preview-text" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </FlowPane>
    <HBox spacing="10">
        <Button text="%company.action.save" onAction="#onSave" styleClass="primary-button,action-save"/>
    </HBox>
</VBox>
