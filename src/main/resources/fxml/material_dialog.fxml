<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import com.electrician.tracker.ui.util.VatSelector?>
<?import com.electrician.tracker.ui.util.DecimalField?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.MaterialDialogController"
      styleClass="form-root" spacing="14" prefWidth="760">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <HBox fx:id="dateRow" spacing="12" alignment="CENTER_LEFT">
        <Label text="%material.field.date" styleClass="form-label" minWidth="130"/>
        <DatePicker fx:id="itemDatePicker"/>
    </HBox>
    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="%material.field.product" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <VBox fx:id="productHolder" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="%material.field.quantity" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DecimalField fx:id="quantityField" scale="3" padDecimals="false" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%material.field.salePrice" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <DecimalField fx:id="unitPriceField" promptText="%material.field.unitPrice" HBox.hgrow="ALWAYS"/>
            <DecimalField fx:id="totalPriceField" promptText="%material.field.totalAmount" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label text="%material.field.saleVat" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <VatSelector fx:id="vatSelector" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label fx:id="purchaseLabel" text="%material.field.purchasePrice" styleClass="form-label"
               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <HBox fx:id="purchaseRow" spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <DecimalField fx:id="purchasePriceField" promptText="%material.field.optional" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="currencyComboBox" prefWidth="100"/>
            <VatSelector fx:id="purchaseVatSelector"/>
        </HBox>

        <Label fx:id="rateLabel" text="%material.field.exchangeRate" styleClass="form-label"
               GridPane.rowIndex="5" GridPane.columnIndex="0" visible="false" managed="false"/>
        <HBox fx:id="rateRow" spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="5" GridPane.columnIndex="1"
              visible="false" managed="false">
            <DecimalField fx:id="exchangeRateField" scale="4" padDecimals="false" prefColumnCount="8"
                          promptText="%material.field.exchangeRate.prompt"/>
            <Label fx:id="conversionLabel" styleClass="conversion-hint" wrapText="true"/>
        </HBox>

        <Label fx:id="supplierLabel" text="%material.field.supplier" styleClass="form-label"
               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <ComboBox fx:id="supplierComboBox" editable="true" promptText="%material.field.optional"
                  GridPane.rowIndex="6" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="%material.field.note" styleClass="form-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="noteField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10" styleClass="dialog-buttons">
        <Button fx:id="saveAndNewButton" text="%material.action.saveAndNew" onAction="#onSaveAndNew" defaultButton="true" styleClass="primary-button,action-add"/>
        <Button fx:id="saveButton" text="%action.save" onAction="#onSave" styleClass="action-save"/>
    </HBox>
    <Label fx:id="addedInSessionLabel" text="%material.dialog.addedInSession" styleClass="form-label"/>
    <TableView fx:id="addedTable" prefHeight="150">
        <columns>
            <TableColumn fx:id="addedProductColumn" text="%material.field.product" prefWidth="300"/>
            <TableColumn fx:id="addedQuantityColumn" text="%material.field.quantity" prefWidth="100"/>
            <TableColumn fx:id="addedVatColumn" text="%material.field.vatRate" prefWidth="90"/>
            <TableColumn fx:id="addedTotalColumn" text="%material.field.total" prefWidth="170"/>
        </columns>
    </TableView>
    <HBox spacing="10" styleClass="dialog-buttons">
        <Button text="%action.close" onAction="#onClose" cancelButton="true"/>
    </HBox>
</VBox>
