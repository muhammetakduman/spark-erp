<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.electrician.tracker.ui.controller.EmployeeListController"
            styleClass="screen-root">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <top>
        <HBox spacing="10" styleClass="toolbar">
            <Button text="%employee.action.new" onAction="#onNew" styleClass="primary-button,action-add"/>
            <Button text="%action.edit" onAction="#onEdit" styleClass="action-edit"/>
            <Button text="%employee.action.toggleActive" onAction="#onToggleActive"/>
            <Button fx:id="deleteButton" text="%action.delete" onAction="#onDelete" styleClass="danger-button,action-delete"/>
            <ProgressIndicator fx:id="loadingIndicator" visible="false" maxHeight="20" maxWidth="20"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="nameColumn" text="%employee.field.name" prefWidth="220"/>
                <TableColumn fx:id="wageColumn" text="%employee.field.wage" prefWidth="140"/>
                <TableColumn fx:id="masterColumn" text="%employee.field.master" prefWidth="100"/>
                <TableColumn fx:id="activeColumn" text="%employee.field.active" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
