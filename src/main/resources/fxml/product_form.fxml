<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import com.electrician.tracker.ui.util.DecimalField?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.ProductFormController"
      styleClass="form-root" spacing="16">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%product.field.name" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%product.field.brand" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="brandComboBox" editable="true" promptText="%material.field.optional"
                  GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>
        <Label text="%product.field.category" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoryComboBox" editable="true" promptText="%material.field.optional"
                  GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>
        <Label text="%product.field.unit" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="unitComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity"/>
        <Label fx:id="supplierLabel" text="%material.field.supplier" styleClass="form-label"
               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="supplierComboBox" editable="true" promptText="%material.field.optional"
                  GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>
        <Label fx:id="purchasePriceLabel" text="%product.field.purchasePrice" styleClass="form-label"
               GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DecimalField fx:id="purchasePriceField" promptText="%material.field.optional"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <CheckBox fx:id="activeCheckBox" text="%common.activeInPickers" selected="true"
                  GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10" styleClass="dialog-buttons">
        <Button text="%action.save" onAction="#onSave" defaultButton="true" styleClass="primary-button,action-save"/>
        <Button text="%action.cancel" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>
