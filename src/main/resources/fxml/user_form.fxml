<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.UserFormController"
      styleClass="form-root" spacing="14" prefWidth="460">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints minWidth="240" hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%user.field.username" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%user.field.fullName" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="%user.field.title" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" promptText="%user.field.title.prompt" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="%user.field.role" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="roleComboBox" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label fx:id="passwordLabel" text="%user.field.password" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label fx:id="passwordRepeatLabel" text="%user.field.passwordRepeat" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordRepeatField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>
    <Label text="%user.role.hint" styleClass="muted-text" wrapText="true"/>
    <HBox spacing="10" styleClass="dialog-buttons">
        <Button fx:id="saveButton" text="%action.save" onAction="#onSave" defaultButton="true" styleClass="primary-button,action-save"/>
        <Button text="%action.cancel" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>
