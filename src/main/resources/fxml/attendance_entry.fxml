<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.AttendanceEntryController"
      styleClass="form-root" spacing="14" prefWidth="620">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label fx:id="jobTitleLabel" styleClass="section-title" wrapText="true"/>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <RadioButton fx:id="singleDayRadio" text="%attendance.mode.singleDay" selected="true">
            <toggleGroup>
                <ToggleGroup fx:id="dateModeGroup"/>
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rangeRadio" text="%attendance.mode.range" toggleGroup="$dateModeGroup"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="startLabel" text="%attendance.field.date" styleClass="form-label"/>
        <DatePicker fx:id="startDatePicker" prefWidth="140"/>
        <Label fx:id="endLabel" text="%attendance.field.endDate" styleClass="form-label"/>
        <DatePicker fx:id="endDatePicker" prefWidth="140"/>
    </HBox>
    <HBox fx:id="weekendBox" spacing="16" alignment="CENTER_LEFT">
        <CheckBox fx:id="skipSaturdayCheckBox" text="%attendance.skipSaturday"/>
        <CheckBox fx:id="skipSundayCheckBox" text="%attendance.skipSunday"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="%attendance.field.employees" styleClass="form-label"/>
        <CheckBox fx:id="showInactiveCheckBox" text="%attendance.showInactive"/>
        <Button text="%employee.action.new" onAction="#onNewEmployee"/>
    </HBox>
    <Label fx:id="noEmployeeLabel" text="%attendance.noActiveEmployee" styleClass="warning-note" wrapText="true"
           visible="false" managed="false"/>
    <ScrollPane fitToWidth="true" prefHeight="260">
        <GridPane fx:id="employeeGrid" hgap="12" vgap="8" styleClass="attendance-grid">
            <padding>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints minWidth="30"/>
                <ColumnConstraints minWidth="220" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="130"/>
                <ColumnConstraints minWidth="90"/>
            </columnConstraints>
        </GridPane>
    </ScrollPane>

    <Label fx:id="previewLabel" styleClass="attendance-preview"/>

    <HBox spacing="10" styleClass="dialog-buttons">
        <Button text="%action.save" onAction="#onSave" defaultButton="true" styleClass="primary-button"/>
        <Button text="%action.cancel" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>
