<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import com.electrician.tracker.ui.util.DecimalField?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.electrician.tracker.ui.controller.ExchangeRateSettingsController"
      fx:id="ratesSection" spacing="10" styleClass="settings-section">
    <Label text="%settings.section.rates" styleClass="section-title"/>
    <Label text="%settings.rates.hint" styleClass="muted-text" wrapText="true"/>
    <GridPane hgap="12" vgap="8" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints prefWidth="160"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%settings.rates.usd" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DecimalField fx:id="usdField" scale="4" padDecimals="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="usdUpdatedLabel" styleClass="muted-text" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Label text="%settings.rates.eur" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DecimalField fx:id="eurField" scale="4" padDecimals="false" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label fx:id="eurUpdatedLabel" styleClass="muted-text" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="%settings.rates.save" onAction="#onSave" styleClass="action-save"/>
    </HBox>
</VBox>
